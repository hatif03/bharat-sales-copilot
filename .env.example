# Supabase (local dev defaults from `npx supabase start` — replace with your
# hosted project's values for staging/production)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — reasoning (Sonnet) + fast classification/shield (Haiku).
# Leave unset during early development: lib/ai falls back to a stub that
# throws AIProviderNotConfiguredError, which feature code catches to serve
# seeded/mock content instead of blocking the build on a missing key.
ANTHROPIC_API_KEY=

# Fallback reasoning provider, used automatically when ANTHROPIC_API_KEY is
# empty (see src/lib/ai/client.ts). Get a free key at console.groq.com.
GROQ_API_KEY=
# GROQ_REASONING_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant

# Kipps.AI — Voice Agent + Chat Agent (mandatory dual-channel per hackathon rules)
KIPPS_API_KEY=
KIPPS_API_BASE_URL=https://backend.kipps.ai
KIPPS_ORGANIZATION_ID=

# Publicly reachable base URL for THIS app — Kipps' servers POST webhook
# events here (lead_webhook_url, voicebot webhook_url). localhost only
# works with a tunnel (ngrok/cloudflared) during local dev; set this to the
# tunnel URL or the deployed Vercel URL.
APP_BASE_URL=http://localhost:3000

# Shared secret Kipps' "API Function" calls must send back as the
# X-Function-Secret header.
KIPPS_FUNCTION_SECRET=

# Twilio — not used by our own code yet. Enter these on Kipps' own
# Integration dashboard page so Kipps owns the actual telephony; kept here
# only for the future in-house outbound-trigger work noted in ROADMAP.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Gmail (secondary follow-up channel, OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.claude/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# reference material only — original Deals Machine pitch deck, transcript,
# screenshots, and the Kipps.AI idea doc. Not part of the shipped app; kept
# out of the repo since some of it is a third party's copyrighted material.
/idea

# typescript
*.tsbuildinfo
next-env.d.ts
